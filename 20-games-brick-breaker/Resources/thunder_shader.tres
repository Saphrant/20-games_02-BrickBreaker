code = "shader_type canvas_item;
render_mode blend_add;

uniform vec2 Speed;
uniform sampler2D basic_texture : source_color, repeat_enable;
uniform sampler2D basic_texture2 : source_color, repeat_enable;



void fragment() {
// Input:8
	vec4 n_out8p0 = COLOR;


// Input:5
	float n_out5p0 = TIME;


// Vector2Parameter:7
	vec2 n_out7p0 = Speed;


// VectorOp:6
	vec2 n_out6p0 = vec2(n_out5p0) * n_out7p0;


// UVFunc:4
	vec2 n_in4p1 = vec2(1.00000, 1.00000);
	vec2 n_out4p0 = n_out6p0 * n_in4p1 + UV;


	vec4 n_out3p0;
// Texture2D:3
	n_out3p0 = texture(basic_texture, n_out4p0);
	float n_out3p1 = n_out3p0.r;


// VectorOp:9
	vec3 n_out9p0 = vec3(n_out8p0.xyz) * vec3(n_out3p1);


	vec4 n_out11p0;
// Texture2D:11
	n_out11p0 = texture(basic_texture2, UV);
	float n_out11p1 = n_out11p0.r;


// VectorOp:12
	vec3 n_out12p0 = n_out9p0 * vec3(n_out11p1);


// Output:0
	COLOR.rgb = n_out12p0;


}
"
